# Environment variables for GrantScout
# Copy this file to .env and fill in your values

# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# Amazon Bedrock Model
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# Grants.gov API (no auth required)
GRANTS_API_BASE_URL=https://api.grants.gov/v1/api

# Storage
S3_BUCKET_NAME=grantscout-data
DYNAMODB_TABLE_NAME=grantscout-grants

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Observability (Optional - Langfuse)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <BASE64_ENCODED_KEY>
# OTEL_SERVICE_NAME=grantscout-agent

# Scan Schedule (in hours)
SCAN_INTERVAL_HOURS=6
