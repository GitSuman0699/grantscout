# Environment variables for GrantScout
# Copy this file to .env and customize for your environment

# ──────────────────────────────────────────────
# AWS & Amazon Bedrock Configuration
# ──────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_PROFILE=default
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_FAST_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_PREMIUM_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ──────────────────────────────────────────────
# Grants.gov Live REST API
# ──────────────────────────────────────────────
GRANTS_API_BASE_URL=https://api.grants.gov/v1/api

# ──────────────────────────────────────────────
# Storage Configuration
# ──────────────────────────────────────────────
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_PATH=./data
S3_BUCKET_NAME=grantscout-data
DYNAMODB_TABLE_NAME=grantscout-grants

# ──────────────────────────────────────────────
# API Server Configuration
# ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ──────────────────────────────────────────────
# Security & Authentication (JWT + API Key)
# ──────────────────────────────────────────────
AUTH_ENABLED=true
SECRET_KEY=grantscout-sec-key-6f8b9e4a3d2c1b0a9f8e7d6c5b4a3210
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MASTER_API_KEY=gs_live_8f7e6d5c4b3a210987654321

# ──────────────────────────────────────────────
# Agent Pipeline Settings
# ──────────────────────────────────────────────
AUTO_SCAN_ENABLED=true
SCAN_INTERVAL_HOURS=24
